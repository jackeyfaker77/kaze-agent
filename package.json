{
  "name": "hasaki-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron-winstaller",
      "uiohook-napi"
    ]
  },
  "scripts": {
    "start": "pnpm run desktop:start",
    "build": "pnpm run build:desktop",
    "build:desktop": "pnpm --filter hasaki-desktop run build",
    "desktop:build": "pnpm run build:desktop",
    "desktop:dev": "pnpm --filter hasaki-desktop run dev",
    "desktop:start": "pnpm --filter hasaki-desktop run start",
    "desktop:test": "node apps/desktop/scripts/test-unit.mjs",
    "desktop:typecheck": "pnpm --filter hasaki-desktop run typecheck",
    "dev": "pnpm run desktop:dev",
    "lint": "pnpm --filter hasaki-desktop run lint",
    "test": "pnpm run desktop:test",
    "typecheck": "pnpm --filter hasaki-desktop run typecheck"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^5.8.0"
  }
}
